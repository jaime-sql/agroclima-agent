# Copy to .env for local use. Never commit .env. Empty keys turn on labelled mock mode.

# Nebius Token Factory API key. Empty → model steps stay in mock mode.
NEBIUS_API_KEY=
# OpenAI-compatible base URL. No trailing path beyond /v1.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA open models served by Token Factory. Plan defaults to Nemotron Super.
# Set NEBIUS_MODEL_PLAN to nvidia/Nemotron-3-Ultra-550b-a55b to use Ultra instead.
NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_PLAN=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL

# Tavily key for the shared alert refresh. Empty → the alert step is a labelled mock.
# Page loads never call Tavily. agroclima-alerts fetches each department at most once per 24h.
TAVILY_API_KEY=
# Hard caps. Basic search costs 1 credit. Defaults stay inside a 1,500 credit/month account.
# TOTAL_CAP 300 is the dev/testing budget. The nightly risk job does not spend these.
TAVILY_DAILY_CAP=40
TAVILY_TOTAL_CAP=300
AGROCLIMA_TAVILY_CACHE=var/tavily-cache.json
AGROCLIMA_TAVILY_COUNTER=var/tavily-usage.json

# Optional. Audit lines are JSON, with hashed inputs, and never store the keys.
AGROCLIMA_AUDIT_LOG=var/audit.jsonl
AGROCLIMA_HOST=127.0.0.1
AGROCLIMA_PORT=8000
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
